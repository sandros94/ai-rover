    {
      "value": "\"status\" in ('active', 'ended')",
      "name": "mission_status_check",
      "entityType": "checks",
      "schema": "public",
      "table": "mission"
    },
    {
      "value": "\"world_hash\" ~ '^[0-9a-f]{16}$'",
      "name": "mission_world_hash_check",
      "entityType": "checks",
      "schema": "public",
      "table": "mission"
    },
    {
      "value": "\"resumed_at\" is null or \"resumed_at\" >= \"paused_at\"",
      "name": "mission_pause_window_check",
      "entityType": "checks",
      "schema": "public",
      "table": "mission_pause"
    },
    {
      "value": "\"status\" in ('open', 'closed', 'void')",
      "name": "round_status_check",
      "entityType": "checks",
      "schema": "public",
      "table": "round"
    },
    {
      "value": "(\"status\" in ('open', 'void') and \"winner_submission_id\" is null) or (\"status\" = 'closed' and \"winner_submission_id\" is not null)",
      "name": "round_winner_check",
      "entityType": "checks",
      "schema": "public",
      "table": "round"
    },
    {
      "value": "\"status\" in ('driving', 'arrived', 'stopped-short', 'failed')",
      "name": "segment_status_check",
      "entityType": "checks",
      "schema": "public",
      "table": "segment"
    },
    {
      "value": "\"attempt\" >= 1",
      "name": "segment_attempt_check",
      "entityType": "checks",
      "schema": "public",
      "table": "segment"
    },
    {
      "value": "\"ends_at\" >= \"started_at\"",
      "name": "segment_window_check",
      "entityType": "checks",
      "schema": "public",
      "table": "segment"
    },
    {
      "value": "case \"status\"\n        when 'driving' then \"to_stop_id\" is null and \"death_x\" is null and \"death_y\" is null\n        when 'failed' then \"to_stop_id\" is null and \"death_x\" is not null and \"death_y\" is not null\n        else \"to_stop_id\" is not null and \"death_x\" is null and \"death_y\" is null\n      end",
      "name": "segment_settled_check",
      "entityType": "checks",
      "schema": "public",
      "table": "segment"
    },
    {
      "value": "\"index\" >= 0",
      "name": "stop_index_check",
      "entityType": "checks",
      "schema": "public",
      "table": "stop"
    },
    {
      "value": "\"status\" in ('open', 'rejected', 'won', 'lost', 'withdrawn')",
      "name": "submission_status_check",
      "entityType": "checks",
      "schema": "public",
      "table": "submission"
    },
    {
      "value": "(\"status\" = 'rejected' and \"rejection_reason\" is not null and \"rejection_reason\" in ('judged-infeasible', 'invalidated-by-stop')) or (\"status\" <> 'rejected' and \"rejection_reason\" is null)",
      "name": "submission_rejection_check",
      "entityType": "checks",
      "schema": "public",
      "table": "submission"
    },
    {
      "value": "\"provider\" in ('github', 'atproto')",
      "name": "user_identity_provider_check",
      "entityType": "checks",
      "schema": "public",
      "table": "user_identity"
    }
