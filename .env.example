NUXT_TYPESAFE_TOKEN=

# Seals the session cookies. Either the JSON of an oct JWK for A256GCM, generated with:
#   node -e "import('unjwt/jwk').then(async ({ generateJWK }) => console.log(JSON.stringify(await generateJWK('A256GCM'))))"
# or a random secret of at least 32 characters the key is derived from. The secret must come from
# a password manager's generator or similar, never a memorable phrase: the derivation adds no
# work factor, so its strength is the secret's own. Empty under `nuxt dev` uses a public
# development key; required everywhere else.
NUXT_SESSION_KEY=

# Unlocks /admin, where an operator lands the mission. Empty disables it. Use a random value.
NUXT_ADMIN_TOKEN=

# Comma list of origins sign-in may redirect back to, e.g. https://rover.example.
# Empty under `nuxt dev` allows any loopback origin (localhost, 127.0.0.1).
NUXT_OAUTH_ORIGINS=

# GitHub OAuth app; its callback URL is <origin>/api/auth/github. Empty hides GitHub sign-in.
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
