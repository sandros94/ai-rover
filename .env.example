# Your own TypeSafe key for Jev judgments. Leave empty on Netlify to use its AI Gateway instead,
# which injects TYPESAFE_API_KEY and TYPESAFE_BASE_URL and bills your Netlify credits.
NUXT_TYPESAFE_TOKEN=

# The root secret the session, sign-in and background-tick keys are derived from: at least 32
# random characters, generated with `openssl rand -base64 32`. Changing it signs everyone out.
# Empty under `nuxt dev` uses one Nuxt generates; required everywhere else.
NUXT_APP_SECRET=

# Who may use /admin (diagnostics, and landing a mission while none is active): a comma list of
# identity keys, provider:subject, as atproto:did:plc:abc123, github:<numeric user id> or
# discord:<user id>. An account is an admin when any identity linked to it is listed. /admin
# shows a signed-in visitor their own keys. Empty allows nobody; malformed entries are ignored
# with a warning at startup.
NUXT_ADMIN_IDENTITIES=

# Comma list of the origins sign-in runs on, e.g. https://rover.example; empty offers no sign-in.
# On Netlify the site's main address (URL) joins it, and AT Protocol alone also signs in on the
# deploy's own addresses (DEPLOY_PRIME_URL, DEPLOY_URL), so deploy previews need no entry.
# Under `nuxt dev` list the dev server's own (http://localhost:3000). AT Protocol signs in on a
# listed https origin without a port, publishing its client at
# <origin>/api/auth/atproto/client-metadata.json, and on a listed loopback one with the atproto
# development client; a localhost sign-in returns through 127.0.0.1 on the same port.
NUXT_OAUTH_ORIGINS=

# GitHub OAuth app; its callback URL is <origin>/api/auth/github. Empty hides GitHub sign-in.
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Discord OAuth app, registered at https://discord.com/developers/applications (OAuth2 tab);
# its redirect is <origin>/api/auth/discord. Empty hides Discord sign-in.
NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=
