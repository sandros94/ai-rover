NUXT_TYPESAFE_TOKEN=

# Seals the session cookies: the JSON of an oct JWK for A256GCM. Empty under `nuxt dev` uses a
# public development key; required everywhere else. Generate one with:
#   node -e "import('unjwt/jwk').then(async ({ generateJWK }) => console.log(JSON.stringify(await generateJWK('A256GCM'))))"
NUXT_SESSION_KEY=

# Comma list of origins sign-in may redirect back to, e.g. https://rover.example.
# Empty under `nuxt dev` allows any loopback origin (localhost, 127.0.0.1).
NUXT_OAUTH_ORIGINS=

# GitHub OAuth app; its callback URL is <origin>/api/auth/github. Empty hides GitHub sign-in.
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
