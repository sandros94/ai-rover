{
  "name": "ai-rover",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "clear": "nuxt cleanup",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "oxlint --fix . && oxfmt .",
    "typecheck": "nuxt typecheck --checker=golar && tsc -p test/tsconfig.json --noEmit",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && pnpm simple-git-hooks",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:nuxt": "vitest run --project nuxt",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:seed": "curl -fsS -X POST -H \"origin: http://localhost:${PORT:-3000}\" http://localhost:${PORT:-3000}/api/_dev/seed"
  },
  "dependencies": {
    "@iconify-json/lucide": "npm:@iconify-json/lucide@^1.2.149",
    "@neondatabase/serverless": "npm:@neondatabase/serverless@^1.2.0",
    "@netlify/blobs": "npm:@netlify/blobs@^11.1.7",
    "@netlify/database": "npm:@netlify/database@^2.0.1",
    "@netlify/functions": "npm:@netlify/functions@^6.0.3",
    "@nuxt/icon": "npm:@nuxt/icon@^2.6.2",
    "@nuxt/ui": "npm:@nuxt/ui@^4.12.0",
    "@tresjs/core": "^5.10.1",
    "@tresjs/nuxt": "^5.8.1",
    "@typesafe-ai/sdk": "npm:@typesafe-ai/sdk@^0.7.0",
    "drizzle-orm": "npm:drizzle-orm@1.0.0-rc.5",
    "nitro": "npm:nitro@3.0.261029-rc",
    "nuxt": "npm:nuxt-nightly@5.0.0-2611010234-c709ec8",
    "pg": "npm:pg@^8.23.1",
    "simplex-noise": "^4.0.3",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "three": "^0.187.0",
    "unauth": "https://pkg.pr.new/sandros94/unauth@d07ba91",
    "unjwt": "^0.7.3",
    "unsecure": "npm:unsecure@^0.3.1",
    "valibot": "npm:valibot@^1.5.0",
    "vue": "npm:vue@^3.5.44"
  },
  "devDependencies": {
    "@dxup/unimport": "npm:@dxup/unimport@^0.1.2",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@0.5.13",
    "@fontsource/public-sans": "^5.3.0",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@golar/vue": "npm:@golar/vue@^0.1.11",
    "@netlify/nuxt": "npm:@netlify/nuxt@^1.0.1",
    "@nuxt/test-utils": "npm:@nuxt/test-utils@^4.3.4",
    "@types/three": "^0.187.0",
    "@vue/test-utils": "npm:@vue/test-utils@^2.5.1",
    "draco3dgltf": "^1.5.9",
    "drizzle-kit": "npm:drizzle-kit@1.0.0-rc.5",
    "golar": "npm:golar@^0.1.11",
    "happy-dom": "npm:happy-dom@^21.0.4",
    "meshoptimizer": "~1.3.0",
    "nuxt-pglite": "https://pkg.pr.new/sandros94/nuxt-pglite@6ab1f85",
    "oxfmt": "npm:oxfmt@^0.75.0",
    "oxlint": "npm:oxlint@^1.90.0",
    "oxlint-tsgolint": "npm:oxlint-tsgolint@~7.0.2005",
    "playwright-core": "npm:playwright-core@^1.64.1",
    "sharp": "^0.35.5",
    "simple-git-hooks": "npm:simple-git-hooks@^2.14.0",
    "takumi-js": "^2.19.0",
    "typescript": "npm:typescript@^7.0.2",
    "vitest": "npm:vitest@^5.0.5",
    "vue-tsc": "npm:vue-tsc@^3.3.14"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm typecheck"
  },
  "packageManager": "pnpm@11.17.0"
}
